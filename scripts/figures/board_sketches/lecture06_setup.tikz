\begin{tikzpicture}[scale=0.85, >=stealth]
\draw[->, thin, gray] (-0.2,-1.1) -- (2.4,-1.1) node[below left, font=\tiny] {$T$};
\draw[->, thin, gray] (-0.2,-1.1) -- (-0.2,1.3) node[left, font=\tiny] {$P$};
\draw[ipsPrimary, thick] (0,-1.0) .. controls (1.2,-0.9) and (1.7,0.0) .. (2.1,1.1);
\node[font=\tiny, ipsPrimary] at (0.45,0.5) {liquid};
\node[font=\tiny, ipsPrimary] at (1.15,-0.8) {vapour};
\fill[ipsOrange] (1.35,-0.33) circle (0.06);
\fill[ipsOrange] (1.84,0.47) circle (0.06);
\draw[ipsOrange, thin, dashed] (1.35,-0.33) -- (1.84,-0.33) node[midway, below=1pt, font=\tiny] {$dT$};
\draw[ipsOrange, thin, dashed] (1.84,-0.33) -- (1.84,0.47) node[midway, right=1pt, font=\tiny] {$dP$};
\end{tikzpicture}
