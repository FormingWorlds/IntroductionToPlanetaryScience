# Large files and symbolic links
content/books
content/course2025

# Local Claude Code session state (bot-only, never commit)
.claude/

# Jupyter Book build artifacts
book/_build/

# Generated from AVIF at build time (see Makefile avif2png target)
book/**/figures/*.png
book/**/figures/*.jpg

# Generated from AVIF/SVG at slide build time (see slides/Makefile)
slides/**/figures/*.png
slides/**/figures/*.pdf
# Slide PDFs are committed at book/_static/slides/lectureNN.pdf (the
# website-facing canonical location). The build artefact in slides/lectureNN/
# is gitignored; copy to book/_static/slides/ when ready to publish.
slides/**/lecture*.pdf

# Generated at worksheet build time (see worksheets/Makefile). Worksheet PDFs
# are committed at book/_static/worksheets/, the website-facing location; the
# build artefacts in worksheets/worksheetNN/ are not.
worksheets/**/*.pdf
worksheets/**/*.aux
worksheets/**/*.out
worksheets/**/*.xdv
worksheets/**/*.fls
worksheets/**/*.fdb_latexmk

# Generated at exam-material build time (see exams/Makefile). The published
# PDFs are committed at book/_static/exams/, the website-facing location.
exams/**/*.pdf
exams/**/*.aux
exams/**/*.out
exams/**/*.xdv
exams/**/*.fls
exams/**/*.fdb_latexmk

# Generated at mini-lecture build time (see minilectures/Makefile). The decks
# are committed at book/_static/minilectures/, the website-facing location.
minilectures/**/*.pdf
minilectures/**/*.aux
minilectures/**/*.out
minilectures/**/*.xdv
minilectures/**/*.fls
minilectures/**/*.fdb_latexmk
minilectures/**/*.nav
minilectures/**/*.snm
minilectures/**/*.toc
minilectures/**/*.vrb

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

